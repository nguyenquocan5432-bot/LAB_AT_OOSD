@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam monochrome true
skinparam backgroundColor white
skinparam ArrowColor black
skinparam usecaseBackgroundColor #F2F2F2
skinparam activityBackgroundColor #F2F2F2
skinparam dpi 180
left to right direction
title Phân rã quy trình "Từ đăng ký tour đến kết thúc tour"
actor "NV bán vé" as BV
actor "NV kinh doanh" as KD
actor "NV điều hành" as DH
actor "Kế toán" as KT
actor "NV chăm sóc KH" as CS
rectangle "Hệ thống quản lý công ty du lịch Văn Hóa Việt" {
usecase "Đăng ký khách lẻ\ntheo chuyến" as LE
usecase "Chọn chuyến đang\nmở đăng ký" as CHON
usecase "Thanh toán tiền vé" as VE
usecase "Lập phiếu đăng ký\ntheo đoàn" as DOAN
usecase "Đặt cọc" as COC
usecase "Nhập danh sách\nngười cùng đi" as DS
usecase "Hủy đăng ký - mất cọc" as HUY
usecase "Phân công\nhướng dẫn viên" as PC
usecase "Kiểm tra trùng lịch HDV" as CHECK
usecase "Thanh toán kinh phí đoàn\nsau tour" as TT
usecase "Gửi phiếu khảo sát" as KS
usecase "Ghi nhận góp ý" as GOPY
}
BV -- LE
KD -- DOAN
KD -- DS
KD -- HUY
DH -- PC
KT -- TT
CS -- KS
CS -- GOPY
LE ..> CHON : <<include>>
LE ..> VE : <<include>>
DOAN ..> COC : <<include>>
DS ..> DOAN : <<extend>>\n[mua bảo hiểm]
HUY ..> DOAN : <<extend>>\n[đoàn không đi]
PC ..> CHECK : <<include>>
GOPY ..> KS : <<extend>>\n[khách phản hồi]
@enduml
