@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam monochrome true
skinparam backgroundColor white
skinparam ArrowColor black
skinparam usecaseBackgroundColor #F2F2F2
skinparam activityBackgroundColor #F2F2F2
skinparam dpi 180
autonumber
actor "NV kinh doanh" as NV
boundary "Form đăng ký đoàn" as FORM
control "Dịch vụ đăng ký đoàn" as SERVICE
database "CSDL" as DB
NV -> FORM : Nhập thông tin đoàn và đăng ký
opt Mua bảo hiểm
  NV -> FORM : Nhập danh sách người cùng đi
end
NV -> FORM : Xác nhận đặt cọc, lập phiếu
FORM -> SERVICE : lapPhieu(thongTin, danhSach)
SERVICE -> SERVICE : Kiểm tra số người, tour,\nngày đi, tiền cọc và danh sách
alt Dữ liệu không hợp lệ
  SERVICE --> FORM : Trả lỗi kiểm tra
  FORM --> NV : Hiển thị lỗi
else Dữ liệu hợp lệ
  SERVICE -> DB : BEGIN TRANSACTION
  DB --> SERVICE : Đã mở giao dịch
  SERVICE -> DB : Lưu đoàn, phiếu đăng ký\nvà danh sách người cùng đi
  DB --> SERVICE : Kết quả lưu
  alt Lưu thành công
    SERVICE -> DB : COMMIT
    DB --> SERVICE : Đã xác nhận giao dịch
    SERVICE --> FORM : Phiếu đăng ký đã lập
    FORM --> NV : Thông báo thành công
  else Lỗi lưu dữ liệu
    SERVICE -> DB : ROLLBACK
    DB --> SERVICE : Đã hủy thay đổi
    SERVICE --> FORM : Lập phiếu thất bại
    FORM --> NV : Thông báo lỗi
  end
end
@enduml
