@startuml
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam monochrome true
skinparam backgroundColor white
skinparam ArrowColor black
skinparam usecaseBackgroundColor #F2F2F2
skinparam activityBackgroundColor #F2F2F2
skinparam dpi 180
start
:Nhận yêu cầu đăng ký;
if (0 < số người < 12?) then (Khách lẻ)
  :Chọn chuyến đang mở đăng ký;
  :Thu đủ tiền vé và lưu đăng ký;
elseif (Số người > 12?) then (Khách đoàn)
  :Nhập thông tin đoàn, tour và ngày đi;
  if (Mua bảo hiểm?) then (Có)
    :Nhập danh sách người cùng đi;
  endif
  :Thu cọc và lập phiếu đăng ký đoàn;
else (Không hợp lệ)
  :Từ chối;\nđúng 12 người chưa được quy định;
  stop
endif
:Phân công HDV;\nkiểm tra không trùng lịch;
if (Đoàn không đi?) then (Có)
  :Hủy đăng ký, mất cọc;\ngỡ phân công;
  stop
endif
:Thực hiện và kết thúc tour;
fork
  if (Là khách đoàn?) then (Có)
    :Thanh toán phần kinh phí còn lại;
  endif
fork again
  :Gửi phiếu khảo sát;
  if (Khách phản hồi?) then (Có)
    :Ghi nhận góp ý;
  endif
end fork
stop
@enduml
